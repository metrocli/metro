# Live apply logs written under packages/*/logs/ stay local. package.json "files"
# also excludes them ("!packages/**/logs") so they never reach the npm package.
packages/**/logs/

# Default scratch payload/plan files that preflight commands write to cwd when
# --out is omitted. Always pass --out on purpose; these stop accidental commits.
/ledger-adjustment-*.json
/move-plan-*.json

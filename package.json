{
  "name": "@metrocli/metro",
  "version": "0.1.1",
  "description": "Metronome in your terminal - safe shapes, gates, and proof for any Metronome tenant.",
  "license": "Apache-2.0",
  "private": false,
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "metro": "bin/metro.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "packages/metro-core/",
    "packages/metro-workspace-generic/",
    "packages/metro-workspace-stub/",
    "docs/metronome-cli/",
    "skills/metro/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metrocli/metro.git"
  },
  "homepage": "https://github.com/metrocli/metro#readme",
  "bugs": {
    "url": "https://github.com/metrocli/metro/issues"
  },
  "scripts": {
    "test": "METRO_DEFAULT_WORKSPACE_PACK=generic node -e \"require(\"./packages/metro-core/src/workspace/loader\").resolvePackId({configDir:\"/tmp\"})\"",
    "harness:onboard": "METRO_DEFAULT_WORKSPACE_PACK=generic node bin/metro.js harness run --suite onboard --execute --json",
    "doctor:smoke": "METRO_DEFAULT_WORKSPACE_PACK=generic node bin/metro.js doctor --json",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "node -e \"const p=require(\"./package.json\"); if(!p.repository||!String(p.repository.url||\"\").includes(\"metrocli/metro\")) { console.error(\"repository.url must point at metrocli/metro\"); process.exit(1) }\""
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "keywords": [
    "metronome",
    "billing",
    "cli",
    "usage-based",
    "contracts",
    "rate-cards"
  ]
}

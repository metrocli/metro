{
  "name": "@metrocli/metro",
  "version": "0.1.1",
  "description": "Metronome in your terminal - safe shapes, gates, and proof for any Metronome tenant.",
  "license": "Apache-2.0",
  "private": false,
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "metro": "bin/metro.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "packages/metro-core/",
    "packages/metro-workspace-generic/",
    "packages/metro-workspace-stub/",
    "docs/metronome-cli/",
    "skills/metro/",
    "AGENTS.md",
    "llms.txt",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metrocli/metro.git"
  },
  "homepage": "https://github.com/metrocli/metro#readme",
  "bugs": {
    "url": "https://github.com/metrocli/metro/issues"
  },
  "scripts": {
    "test": "node --test test/*.test.js packages/metro-workspace-generic/test/*.test.js",
    "harness:onboard": "node bin/metro.js harness run --suite onboard --execute --json",
    "doctor:smoke": "node bin/metro.js doctor --json"
  }
}

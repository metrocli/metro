{
  "name": "@metrocli/metro",
  "version": "0.1.1",
  "description": "Metronome in your terminal - safe shapes, gates, and proof for any Metronome tenant.",
  "license": "Apache-2.0",
  "private": false,
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "metro": "bin/metro.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "packages/metro-core/",
    "packages/metro-workspace-generic/",
    "packages/metro-workspace-stub/",
    "!packages/**/logs",
    "docs/metronome-cli/",
    "skills/",
    "AGENTS.md",
    "llms.txt",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metrocli/metro.git"
  },
  "homepage": "https://github.com/metrocli/metro#readme",
  "bugs": {
    "url": "https://github.com/metrocli/metro/issues"
  },
  "scripts": {
    "test": "node --test test/*.test.js packages/metro-workspace-generic/test/*.test.js",
    "harness:onboard": "node bin/metro.js harness run --suite onboard --execute --json",
    "doctor:smoke": "node bin/metro.js doctor --json",
    "docs:upstream:check": "node scripts/metronome-upstream-check.js",
    "docs:upstream:generate": "node scripts/generate-metronome-upstream.js --fetch",
    "docs:api:coverage": "node scripts/metronome-api-coverage.js",
    "docs:api:coverage:check": "node scripts/metronome-api-coverage.js --check",
    "pack:verify": "node scripts/verify-pack.js",
    "docs:site:refresh": "node scripts/docs-site-refresh.js",
    "docs:site:verify": "node scripts/docs-site-refresh.js --check",
    "prepublishOnly": "node -e \"const p=require('./package.json'); if(!String((p.repository||{}).url||'').includes('metrocli/metro')){console.error('repository.url must point at metrocli/metro'); process.exit(1)}\""
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "keywords": [
    "metronome",
    "billing",
    "cli",
    "usage-based",
    "contracts",
    "rate-cards",
    "agents"
  ]
}
